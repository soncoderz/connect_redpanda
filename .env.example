PORT=3000
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=connect-redpanda-backend
APPOINTMENT_TOPIC=appointment-events
NODE_CONSUMER_GROUP=node-appointment-consumer-group
USERS_TOPIC=users
MAIL_LOG_TOPIC=mail-logs
APP_BASE_URL=http://localhost:3000
MAIL_CONFIRM_PATH=/api/users/confirm
MAIL_CONFIRM_SUBJECT=Xac nhan tai khoan

# SMTP app password example: Gmail uses smtp.gmail.com:465 with a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
