            "url": {
              "raw": "{{baseUrl}}/api/publish/all-events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "all-events"]
            }
          },
          "response": []
        },
        {
          "name": "[#29] Batch: gửi nhiều message (high-volume-events)",
