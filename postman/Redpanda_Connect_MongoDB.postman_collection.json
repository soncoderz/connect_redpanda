            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"GROUP_A\",\n  \"data\": \"Dữ liệu nhóm A → collection group_a_events\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "events"]
