          "response": []
        },
        {
          "name": "[#7,#26] Route theo groupId → GROUP_B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"GROUP_B\",\n  \"data\": \"Dữ liệu nhóm B → collection group_b_events\"\n}"
