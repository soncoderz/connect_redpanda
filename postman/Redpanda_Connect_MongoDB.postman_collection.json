            "url": {
              "raw": "{{baseUrl}}/api/publish/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "events"]
            }
          },
          "response": []
        },
        {
          "name": "[#8,#11,#12] Transform: đổi tên + xóa field nhạy cảm",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"raw-001\",\n  \"userName\": \"Tran Van B\",\n  \"userEmail\": \"b@test.com\",\n  \"status\": \"PENDING\",\n  \"password\": \"supersecret123\",\n  \"internalCode\": \"INT-999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/raw-events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "raw-events"]
