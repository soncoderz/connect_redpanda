    {
      "name": "1. Dynamic Publish (bất kỳ topic nào)",
      "description": "POST /api/publish/:topic — Gửi event vào bất kỳ topic nào. Redpanda Connect sẽ tự xử lý phía sau.",
      "item": [
        {
          "name": "[#1,#2] topic=users → collection users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"add\",\n  \"name\": \"Nguyen Van A\",\n  \"email\": \"a@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "users"]
            }
          },
          "response": []
        },
        {
          "name": "[#3] topic=orders → collection orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"add\",\n  \"item\": \"Laptop\",\n  \"amount\": 25000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "orders"]
            }
          },
          "response": []
        },
        {
          "name": "[#3] topic=payments → collection payments",
