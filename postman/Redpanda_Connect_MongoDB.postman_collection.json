        {
          "name": "[#4] Fan-in: nhiều topic → 1 collection all_events",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"add\",\n  \"note\": \"Gom chung vào collection all_events\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "users"]
            }
          },
          "response": []
        },
        {
          "name": "[#5,#6] Filter eventType HỢP LỆ (ORDER_CREATED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"ORDER_CREATED\",\n  \"item\": \"Bàn phím cơ\",\n  \"amount\": 1500000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "orders"]
            },
            "description": "eventType=ORDER_CREATED → vượt qua filter → lưu vào MongoDB."
          },
          "response": []
        },
        {
          "name": "[#5,#6] Filter eventType BỊ BỎ QUA (ORDER_CANCELLED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"ORDER_CANCELLED\",\n  \"item\": \"TV\",\n  \"note\": \"eventType này sẽ bị Redpanda Connect bỏ qua bằng deleted()\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/publish/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "publish", "orders"]
            }
          },
          "response": []
        },
        {
